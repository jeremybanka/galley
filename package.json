{
	"name": "galley-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "pnpm build:mdx && mise exec -- cargo fmt --all --check && dprint check",
		"check:vp": "vp check --no-fmt",
		"check:spelling": "cspell .",
		"fmt": "pnpm build:mdx && mise exec -- cargo fmt --all && dprint fmt",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "pnpm build:mdx && changeset version",
		"staged": "vp staged",
		"test": "pnpm build:mdx && pnpm test:rust && pnpm test:wasm && pnpm test:galley",
		"test:rust": "mise exec -- cargo test --locked",
		"test:wasm": "pnpm --filter dprint-plugin-mdx exec vp test",
		"test:galley": "pnpm --filter galley.md exec vp test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "./scripts/update-workflows.node.ts",
		"test:public": "pnpm --filter galley.md run test:public",
		"test:private": "pnpm --filter galley.md run test:private",
		"test:breakage": "vp run -r --no-cache test:breakage",
		"check:rust": "mise exec -- cargo clippy --locked --all-targets -- -D warnings",
		"build:mdx": "node scripts/build-mdx-plugin.node.ts",
		"check:mdx": "tsc --runExternalCode --project tsconfig.json",
		"check:unused": "knip",
		"check:unused:production": "knip --production"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.49.1",
		"@dprint/toml": "0.10.0",
		"@types/node": "26.6.6",
		"cspell": "10.4.1",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"galley.md": "workspace:*",
		"knip": "6.44.2",
		"typescript": "7.1.0-dev.20261110.1",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.13.0",
		"pnpm": "12.18.0"
	}
}
