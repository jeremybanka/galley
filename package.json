{
	"name": "galley-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:vp": "vp check --no-fmt",
		"check:spelling": "cspell .",
		"fmt": "dprint fmt",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "./scripts/update-workflows.node.ts",
		"test:public": "pnpm --filter galley.md run test:public",
		"test:private": "pnpm --filter galley.md run test:private",
		"test:breakage": "vp run -r --no-cache test:breakage"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.27.1",
		"@dprint/oxc": "0.47.0",
		"@dprint/toml": "0.9.0",
		"@types/node": "26.6.5",
		"cspell": "10.4.0",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.6",
		"dprint-plugin-yaml": "0.6.0",
		"galley.md": "workspace:*",
		"typescript": "7.1.0-dev.20261024.1",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "26.12.1",
		"pnpm": "12.15.0"
	}
}
