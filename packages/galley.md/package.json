{
	"name": "galley.md",
	"version": "0.3.1",
	"description": "Compile MDX components and source imports into plain Markdown.",
	"homepage": "https://github.com/jeremybanka/galley#readme",
	"bugs": {
		"url": "https://github.com/jeremybanka/galley/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/galley.git",
		"directory": "packages/galley.md"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.mts",
			"import": "./dist/jsx-runtime.mjs"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-runtime.d.mts",
			"import": "./dist/jsx-runtime.mjs"
		},
		"./package.json": "./package.json",
		"./content-mapper": {
			"types": "./dist/mapper.d.mts",
			"import": "./dist/mapper.mjs"
		}
	},
	"bin": {
		"galley": "./dist/cli.mjs",
		"galley-content-mapper": "./dist/content-mapper.mjs",
		"galley-lsp": "./dist/lsp.mjs"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"AGENTS.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vp pack",
		"test": "node ../../scripts/build-mdx-plugin.node.ts && vp test",
		"test:watch": "vp test watch",
		"prepare": "pnpm build",
		"test:public": "vp test __tests__/public",
		"test:private": "node ../../scripts/build-mdx-plugin.node.ts && vp test __tests__/private",
		"test:breakage": "pnpm run test:breakage:prelude && breakage breakage.config.ts --verbose --baseline-file .breakage/baseline.json",
		"test:breakage:prelude": "breakage prelude --out .breakage/baseline.json"
	},
	"dependencies": {
		"@babel/parser": "8.0.8",
		"@dprint/formatter": "0.6.0",
		"@dprint/markdown": "0.28.2",
		"@mdx-js/mdx": "3.1.1",
		"@types/mdast": "4.0.4",
		"@types/react": "19.3.0",
		"@vscode/vsce": "4.0.0",
		"comline": "0.9.3",
		"diff": "9.0.0",
		"esbuild": "0.28.2",
		"hast-util-phrasing": "3.0.1",
		"hast-util-to-html": "9.0.5",
		"mdast-util-to-hast": "13.2.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"remark-parse": "11.0.0",
		"remark-stringify": "11.0.0",
		"typescript": "7.1.0-dev.20261028.1",
		"unified": "11.0.5",
		"vscode-jsonrpc": "10.0.0",
		"vscode-languageclient": "11.0.0",
		"vscode-languageserver": "11.0.0",
		"vscode-languageserver-textdocument": "1.0.16",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/node": "26.6.6",
		"@types/vscode": "1.140.0",
		"breakage": "0.10.1",
		"shiki": "4.5.0"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.18.0",
		"pnpm": "12.16.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"dist/content-mapper.mjs"
			],
			"compilerOptions": [
				"allowJs",
				"jsxImportSource"
			],
			"dynamicConfig": false
		}
	}
}
