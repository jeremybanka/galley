{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"lineWidth": 80,
	"incremental": false,
	"useTabs": true,
	"indentWidth": 2,
	"includes": [
		"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,css,astro,toml,yml,yaml}"
	],
	"excludes": [
		"packages/galley.md/__tests__/fixtures/**/*.expected.md",
		"packages/galley.md/__tests__/fixtures/mdx-plugin/**",
		"packages/galley.md/__tests__/fixtures/compiler/{embedded-examples,markdown-formatting}.mdx",
		"packages/galley.md/__tests__/fixtures/frontmatter/{invalid-yaml,duplicate-output,multiline}.mdx",
		"packages/galley.md/__tests__/fixtures/editor/{highlighting,incomplete-import,recovery,typed,typed-formatting}.mdx",
		"**/metafile-*",
		"**/*.cache.json",
		"**/*.gen.ts",
		"**/*.gen.tsx",
		"**/pnpm-lock.yaml",
		"**/*.scss",
		"**/*.tsdoc.json",
		"**/.astro/**",
		"**/.next/**",
		"**/.turbo/**",
		"**/.varmint/**",
		"**/.wrangler/**",
		"**/app/**",
		"**/bin/**",
		"**/coverage/**",
		"**/dist/**",
		"**/drizzle/meta/**",
		"**/heap.json",
		"**/node_modules/**",
		"**/projects/**",
		"**/target/**",
		"packages/dprint-plugin-galley-mdx/tests/**",
		"packages/dprint-plugin-galley-mdx/source/**"
	],
	"oxc": {
		"associations": [
			"**/*.{ts,tsx,js,jsx,mjs,cjs}"
		],
		"semicolons": "asNeeded",
		"trailingCommas": "all"
	},
	"json": {
		"associations": [
			"**/*.{json,jsonc}"
		]
	},
	"markdown": {
		"associations": [
			"**/*.md"
		]
	},
	"malva": {
		"associations": [
			"**/*.css"
		]
	},
	"toml": {
		"associations": [
			"**/*.toml"
		]
	},
	"yaml": {
		"associations": [
			"**/*.{yml,yaml}"
		]
	},
	"plugins": [
		"./node_modules/@dprint/oxc/plugin.wasm",
		"./node_modules/@dprint/json/plugin.wasm",
		"./node_modules/@dprint/markdown/plugin.wasm",
		"./node_modules/dprint-plugin-malva/plugin.wasm",
		"./node_modules/@dprint/toml/plugin.wasm",
		"./node_modules/dprint-plugin-yaml/plugin.wasm",
		"./packages/dprint-plugin-galley-mdx/plugin.wasm"
	],
	"mdx": {
		"associations": [
			"**/*.mdx"
		]
	}
}
