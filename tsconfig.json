{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"lib": [
			"ES2024"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"#fixtures/*": [
				"./packages/galley.md/__tests__/fixture-text.d.ts"
			],
			"galley.md": [
				"./packages/galley.md/src/index.ts"
			]
		},
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": [
			"node"
		],
		"jsx": "react-jsx",
		"jsxImportSource": "galley.md"
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.mdx",
		"*.d.ts"
	],
	"exclude": [
		"packages/*/__tests__/fixtures"
	],
	"contentMappers": [
		{
			"package": "galley.md",
			"extensions": [
				".mdx"
			]
		}
	]
}
