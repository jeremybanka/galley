{
	"name": "galley-vscode",
	"displayName": "galley.mdx",
	"version": "0.1.0",
	"private": true,
	"description": "MDX to Markdown, with typed import attributes and component output beside its source.",
	"repository": "https://github.com/jeremybanka/galley.mdx",
	"license": "MPL-2.0",
	"publisher": "jeremybanka",
	"main": "./dist/extension.cjs",
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md",
		"README.md",
		"LICENSE",
		"language-configuration.json",
		"galley.tmLanguage.json"
	],
	"contributes": {
		"languages": [
			{
				"id": "galley",
				"aliases": ["galley.mdx", "Galley"],
				"extensions": [".mdx"],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "galley",
				"scopeName": "source.galley",
				"path": "./galley.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.javascript": "javascriptreact"
				}
			}
		],
		"commands": [
			{
				"command": "galley.refreshPreview",
				"title": "galley.mdx: Refresh Component Output"
			},
			{
				"command": "galley.peekOutput",
				"title": "galley.mdx: Peek Generated Markdown"
			},
			{
				"command": "galley.restartServer",
				"title": "galley.mdx: Restart Language Server"
			}
		],
		"configuration": {
			"title": "galley.mdx",
			"properties": {
				"galley.preview.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show component output summaries, hover previews, and inline peek actions. Evaluates trusted components on open, save, or explicit refresh."
				},
				"galley.trace.server": {
					"type": "string",
					"enum": ["off", "messages", "verbose"],
					"default": "off",
					"description": "Trace communication with the galley.mdx language server."
				}
			}
		}
	},
	"activationEvents": ["onLanguage:galley"],
	"engines": { "vscode": "^1.105.0" },
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Component previews execute the document and its imports."
		}
	},
	"extensionKind": ["workspace"]
}
