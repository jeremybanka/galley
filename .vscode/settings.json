{
	"files.associations": {
		"*.mdx": "galley"
	},
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "dprint.dprint",
	"dprint.path": "node_modules/.bin/dprint",
	"dprint.verbose": true,
	"editor.codeActionsOnSave": {
		"source.fixAll.oxc": "explicit"
	},
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"[galley]": {
		"editor.defaultFormatter": "dprint.dprint"
	}
}
